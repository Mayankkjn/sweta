          "$value": "#1C2518",
          "$description": "Dark FIRE result screens."
        },
        "accent": {
          "$value": "{primitive.color.warning.600}"
        }
      }
    },
    "gradient": {
      "$type": "gradient",
      "green": {
        "$value": [
          {
            "color": "#1F673F",
            "position": 0.0166
          },
          {
            "color": "#57A870",
            "position": 1.4987
          }
        ],
        "$description": "From Figma: primary button, 94deg. The end stop sits past the box edge, so the visible right edge is ~#449260."
      },
      "teal": {
        "$value": [
          {
            "color": "#205558",
            "position": 0
          },
          {
            "color": "#166159",
            "position": 1
          }
        ],
        "$description": "derived: active segment of the You / Spouse toggle."
      }
