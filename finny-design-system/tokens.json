{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Finny design tokens, derived from the Finny style guide (style_guide.pdf). Three tiers: primitive -> semantic -> component. Values marked 'derived' were measured from the PDF artwork rather than read from a label; values marked 'proposed' are not in the PDF and fill gaps.",
  "primitive": {
    "color": {
      "$type": "color",
      "primary": {
        "900": {
          "$value": "#02372F",
          "$description": "Deep forest. Brand anchor."
        },
        "800": {
          "$value": "#1B4B44",
          "$description": "Headings, icons."
        },
        "700": {
          "$value": "#03685A",
          "$description": "Teal accent."
        },
        "500": {
          "$value": "#4E736E"
        },
        "400": {
          "$value": "#678782"
        },
        "300": {
          "$value": "#9AAFAC"
        }
      },
      "neutral": {
        "900": {
          "$value": "#01231E",
          "$description": "Near-black ink; also the dark header band."
        },
        "700": {
          "$value": "#576361"
        },
        "500": {
          "$value": "#909D9B"
        },
        "300": {
          "$value": "#CCD7D5"
        },
        "200": {
          "$value": "#E6EBEA"
        },
        "100": {
          "$value": "#F5F7F7"
        },
        "0": {
          "$value": "#FFFFFF"
        }
      },
      "green": {
        "500": {
          "$value": "#4C9B66",
          "$description": "Success / brand green. Also the 'BG' green swatch (PDF mislabels it #02372F)."
        },
        "600": {
          "$value": "#236B42",
          "$description": "Alias of green-700, kept for compatibility. The PDF-era #2E7A4A is replaced by the Figma value."
        },
        "200": {
          "$value": "#CCE6D4"
        },
        "50": {
          "$value": "#EEF7F1",
          "$description": "derived: rendered swatch and selected-chip fill."
        },
        "700": {
          "$value": "#236B42",
          "$description": "From Figma: links, 'View all', secondary button text (6.46:1 on white)."
        }
      },
      "red": {
        "500": {
          "$value": "#C85267"
        },
        "600": {
          "$value": "#B4475B",
          "$description": "proposed: AA-safe text variant (5.26:1 on white)."
        },
        "50": {
          "$value": "#F9ECEE"
        }
      },
      "amber": {
        "500": {
          "$value": "#C88A52"
        },
        "600": {
          "$value": "#9A6531",
          "$description": "proposed: AA-safe text variant (4.91:1 on white)."
        },
        "50": {
          "$value": "#F9F2EC"
        }
      },
      "cream": {
        "50": {
          "$value": "#F5F6F0",
          "$description": "derived: 'BG' off-white swatch (PDF mislabels it #02372F)."
        }
      },
      "scrim": {
        "$value": "#000F0DE6",
        "$description": "From Figma: rgba(0,15,13,.9) behind bottom sheets."
      }
    },
    "gradient": {
      "$type": "gradient",
      "green": {
        "$value": [
          {
            "color": "#1F673F",
            "position": 0.0166
          },
          {
            "color": "#57A870",
            "position": 1.4987
          }
        ],
        "$description": "From Figma: primary button, 94deg. The end stop sits past the box edge, so the visible right edge is ~#449260."
      },
      "teal": {
        "$value": [
          {
            "color": "#205558",
            "position": 0
          },
          {
            "color": "#166159",
            "position": 1
          }
        ],
        "$description": "derived: active segment of the You / Spouse toggle."
      }
    },
    "fontFamily": {
      "$type": "fontFamily",
      "base": {
        "$value": [
          "Poppins",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ]
      }
    },
    "fontWeight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "fontSize": {
      "$type": "dimension",
      "10": {
        "$value": "10px"
      },
      "12": {
        "$value": "12px"
      },
      "14": {
        "$value": "14px"
      },
      "16": {
        "$value": "16px"
      },
      "20": {
        "$value": "20px"
      },
      "24": {
        "$value": "24px"
      },
      "28": {
        "$value": "28px"
      },
      "32": {
        "$value": "32px"
      }
    },
    "lineHeight": {
      "$type": "number",
      "tight": {
        "$value": 1.25,
        "$description": "proposed: headings."
      },
      "snug": {
        "$value": 1.4,
        "$description": "proposed: subtitles."
      },
      "normal": {
        "$value": 1.5,
        "$description": "proposed: body and caption."
      }
    },
    "space": {
      "$type": "dimension",
      "$description": "proposed: 4px grid, matching the spacing seen in the screen examples.",
      "0": {
        "$value": "0px"
      },
      "1": {
        "$value": "4px"
      },
      "2": {
        "$value": "8px"
      },
      "3": {
        "$value": "12px"
      },
      "4": {
        "$value": "16px"
      },
      "5": {
        "$value": "20px"
      },
      "6": {
        "$value": "24px"
      },
      "8": {
        "$value": "32px"
      },
      "10": {
        "$value": "40px"
      },
      "12": {
        "$value": "48px"
      }
    },
    "radius": {
      "$type": "dimension",
      "xs": {
        "$value": "4px",
        "$description": "Video thumbnails."
      },
      "sm": {
        "$value": "8px",
        "$description": "From Figma: buttons, inputs, chips, FAQ answer, stat tiles."
      },
      "md": {
        "$value": "12px",
        "$description": "From Figma: cards, option rows, account groups."
      },
      "lg": {
        "$value": "16px",
        "$description": "From Figma: bottom sheets and content panels (top corners)."
      },
      "pill": {
        "$value": "999px",
        "$description": "Toggle, tags, status pills, channel chips."
      }
    },
    "borderWidth": {
      "$type": "dimension",
      "hairline": {
        "$value": "1px"
      }
    },
    "shadow": {
      "$type": "shadow",
      "card": {
        "$value": {
          "color": "#B2B2B23D",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "5px",
          "spread": "0px"
        },
        "$description": "From Figma: option rows and cards."
      },
      "raised": {
        "$value": {
          "color": "#01231E1F",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "12px",
          "spread": "0px"
        },
        "$description": "proposed: sticky footers, sheets."
      },
      "panel": {
        "$value": {
          "color": "#E6EBEA",
          "offsetX": "0px",
          "offsetY": "-6px",
          "blur": "24px",
          "spread": "0px"
        },
        "$description": "From Figma: panels and sheets rising over a hero."
      }
    }
  },
  "semantic": {
    "color": {
      "$type": "color",
      "bg": {
        "canvas": {
          "$value": "{primitive.color.cream.50}",
