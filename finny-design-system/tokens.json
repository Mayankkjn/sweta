      "base": {
        "$value": [
          "Poppins",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ]
      }
    },
    "fontWeight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "fontSize": {
      "$type": "dimension",
      "10": {
        "$value": "10px"
      },
      "12": {
        "$value": "12px"
      },
      "14": {
        "$value": "14px"
      },
      "16": {
        "$value": "16px"
      },
      "20": {
        "$value": "20px"
      },
      "24": {
        "$value": "24px"
      },
      "28": {
        "$value": "28px"
      },
      "32": {
        "$value": "32px"
      }
    },
    "lineHeight": {
      "$type": "number",
      "tight": {
        "$value": 1.25,
        "$description": "proposed: headings."
      },
      "snug": {
        "$value": 1.4,
        "$description": "proposed: subtitles."
      },
      "normal": {
        "$value": 1.5,
        "$description": "proposed: body and caption."
      }
    },
    "space": {
      "$type": "dimension",
      "$description": "proposed: 4px grid, matching the spacing seen in the screen examples.",
      "0": {
        "$value": "0px"
      },
      "1": {
        "$value": "4px"
      },
      "2": {
        "$value": "8px"
      },
      "3": {
        "$value": "12px"
      },
      "4": {
        "$value": "16px"
      },
      "5": {
        "$value": "20px"
      },
      "6": {
        "$value": "24px"
      },
      "8": {
        "$value": "32px"
      },
      "10": {
        "$value": "40px"
      },
      "12": {
        "$value": "48px"
      }
    },
    "radius": {
      "$type": "dimension",
      "xs": {
        "$value": "4px",
        "$description": "Video thumbnails."
      },
      "sm": {
        "$value": "8px",
        "$description": "From Figma: buttons, inputs, chips, FAQ answer, stat tiles."
      },
      "md": {
        "$value": "12px",
        "$description": "From Figma: cards, option rows, account groups."
      },
      "lg": {
        "$value": "16px",
        "$description": "From Figma: bottom sheets and content panels (top corners)."
      },
      "pill": {
        "$value": "999px",
        "$description": "Toggle, tags, status pills, channel chips."
      }
    },
    "borderWidth": {
      "$type": "dimension",
      "hairline": {
        "$value": "1px"
      }
    },
    "shadow": {
      "$type": "shadow",
      "card": {
        "$value": {
          "color": "#D4D4D480",
          "offsetX": "0px",
          "offsetY": "3px",
          "blur": "15px",
          "spread": "0px"
        },
        "$description": "Figma effect 'Card Shadow light'."
      },
      "raised": {
        "$value": {
          "color": "#01231E1F",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "12px",
          "spread": "0px"
        },
        "$description": "proposed: sticky footers, sheets."
      },
      "panel": {
        "$value": {
          "color": "#E6EBEA",
          "offsetX": "0px",
          "offsetY": "-6px",
          "blur": "24px",
          "spread": "0px"
        },
        "$description": "From Figma: panels and sheets rising over a hero."
      },
      "card-strong": {
        "$value": {
          "color": "#D4D4D4",
          "offsetX": "0px",
          "offsetY": "3px",
          "blur": "15px",
          "spread": "0px"
        },
        "$description": "Figma effect 'Card shadow'."
      },
      "row": {
        "$value": {
          "color": "#B2B2B23D",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "5px",
          "spread": "0px"
        },
        "$description": "Option rows in the login flows."
      }
    }
  },
