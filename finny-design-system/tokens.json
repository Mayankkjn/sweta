{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Finny design tokens, derived from the Finny style guide (style_guide.pdf). Three tiers: primitive -> semantic -> component. Values marked 'derived' were measured from the PDF artwork rather than read from a label; values marked 'proposed' are not in the PDF and fill gaps. Colour primitives use the same names and numbers as the Figma variables (Primary 100–600, Neutral 100–600, Success, Error).",
  "primitive": {
    "color": {
      "$type": "color",
      "primary": {
        "600": {
          "$value": "#02372F",
          "$description": "Deep forest. Brand anchor."
        },
        "500": {
          "$value": "#1B4B44",
          "$description": "Headings, icons."
        },
        "400": {
          "$value": "#03685A",
          "$description": "Teal accent."
        },
        "300": {
          "$value": "#4E736E"
        },
        "200": {
          "$value": "#678782"
        },
        "100": {
          "$value": "#9AAFAC"
        }
      },
      "neutral": {
        "600": {
          "$value": "#01231E",
          "$description": "Near-black ink; also the dark header band."
        },
        "500": {
          "$value": "#576361"
        },
        "400": {
          "$value": "#909D9B"
        },
        "300": {
          "$value": "#CCD7D5"
        },
        "200": {
          "$value": "#E6EBEA"
        },
        "100": {
          "$value": "#F5F7F7"
        }
      },
      "cream": {
        "50": {
          "$value": "#F5F6F0",
          "$description": "derived: 'BG' off-white swatch (PDF mislabels it #02372F)."
        }
      },
      "scrim": {
        "$value": "#000F0DE6",
        "$description": "From Figma: rgba(0,15,13,.9) behind bottom sheets."
      },
      "success": {
        "700": {
          "$value": "#236B42",
          "$description": "From Figma: links, 'View all', secondary button text (6.46:1 on white)."
        },
        "600": {
          "$value": "#4C9B66",
          "$description": "Success / brand green. Also the 'BG' green swatch (PDF mislabels it #02372F)."
        },
        "100": {
          "$value": "#CCE6D4"
        },
        "50": {
          "$value": "#EEF7F1",
          "$description": "derived: rendered swatch and selected-chip fill."
        }
      },
      "error": {
        "700": {
          "$value": "#B4475B",
          "$description": "proposed: AA-safe text variant (5.26:1 on white)."
        },
        "600": {
          "$value": "#C85267"
        },
        "50": {
          "$value": "#F9ECEE"
        }
      },
      "warning": {
        "700": {
          "$value": "#9A6531",
          "$description": "proposed: AA-safe text variant (4.91:1 on white)."
        },
        "600": {
          "$value": "#C88A52"
        },
        "50": {
          "$value": "#F9F2EC"
        }
      },
      "white": {
        "$value": "#FFFFFF"
      },
      "tint": {
        "spends": {
          "$value": "#EAD8E2",
          "$description": "Breakdown row fill"
        },
        "investment": {
          "$value": "#CBCDE5",
          "$description": "Breakdown row fill"
        },
        "loans": {
          "$value": "#E4E3CC",
          "$description": "Breakdown row fill"
        },
        "untagged": {
          "$value": "#DFDFDF",
          "$description": "Breakdown row fill"
        },
        "surplus": {
          "$value": "#C0DFCA",
          "$description": "Cash remaining"
        },
        "shortfall": {
          "$value": "#FCCBCC",
          "$description": "Income shortfall"
        }
      },
      "fire": {
